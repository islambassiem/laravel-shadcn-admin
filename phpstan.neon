includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes


    level: max

    tmpDir: /tmp/phpstan

    excludePaths:
        # exclude starter kit files
        - ./database/migrations/2026_08_30_084706_create_permission_tables.php
#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
